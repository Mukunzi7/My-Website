# EduBridge production environment example
# Copy these into your hosting provider's environment variables.
# Do not commit real secrets.

HOST=0.0.0.0
PORT=8080
APP_BASE_URL=https://www.yourdomain.com

# Bird / MessageBird email API. Recommended for EduBridge transactional emails.
# Replace bk_xxxxxxxxx with your real key only in your local/hosting environment.
# Never commit the real key to GitHub.
BIRD_API_KEY=bk_xxxxxxxxx
BIRD_FROM=onboarding@messagebird.dev
# Optional. Usually auto-detected from key prefix: bk_us1_... or bk_eu1_...
BIRD_REGION=us1

# Admin account created automatically when the app starts.
ADMIN_EMAIL=honoremukunzi6@gmail.com
ADMIN_PASSWORD=Admin123!

# Email verification and password reset SMTP.
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@yourdomain.com
SMTP_TLS=1

# Cloud uploads through Cloudinary unsigned upload preset.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset

# Future PostgreSQL production database.
# Current app still uses SQLite unless a PostgreSQL adapter is added.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/edubridge

# Funding model:
# Each project creator enters their own Mobile Money details.
# Sponsors send funds directly to the creator, not to the platform owner.

# Optional project upload app limit in bytes. 0 means no EduBridge app limit.
MAX_UPLOAD_BYTES=0
