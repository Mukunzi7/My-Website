# Example only. Set real secrets in Render Environment; never commit them.
HOST=0.0.0.0
PORT=10000
APP_BASE_URL=https://seven0scholar-7cjc.onrender.com
ADMIN_EMAIL=honoremukunzi6@gmail.com
ADMIN_PASSWORD=CHANGE-THIS-TO-A-LONG-UNIQUE-SECRET

# Pick ONE provider. Explicit selection never falls back to another provider.
# For Brevo: verify this individual sender in Brevo, then set these privately in Render.
# EMAIL_PROVIDER=brevo
# BREVO_FROM=honoremukunzi6@gmail.com
# BREVO_API_KEY=PASTE_YOUR_BREVO_API_KEY_PRIVATELY_IN_RENDER
# Brevo may rewrite a Gmail sender and track opens/clicks; see BREVO_EMAIL_SETUP.md.
#
# For Bird: use an address on a Bird-verified domain; onboarding is sandbox-restricted.
# EMAIL_PROVIDER=bird
# BIRD_API_KEY=bk_us1_REPLACE_ME
# BIRD_FROM=noreply@your-verified-domain.com
# BIRD_REGION=us1
#
# For SMTP (Render Free blocks ports 25, 465 and 587):
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=noreply@your-verified-domain.com
# SMTP_TLS=1
# If EMAIL_PROVIDER is unset, the previous Bird-first, then SMTP behavior is unchanged;
# Brevo is used only when EMAIL_PROVIDER=brevo is explicitly set.

# Supabase (set actual values privately in Render; never commit secrets).
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@SESSION_POOLER_HOST:5432/postgres
# SUPABASE_URL=https://PROJECT_REF.supabase.co
# SUPABASE_SECRET_KEY=REPLACE_WITH_SERVER_ONLY_SECRET_KEY
# SUPABASE_STORAGE_BUCKET=70scholar-private
# Project/profile uploads are limited to 10 MiB; slideshow source photos to 8 MiB.

# Alternative: a mounted persistent disk on a paid Render service; keep separate backups.
# DB_PATH=/var/data/70scholar.sqlite3
# UPLOAD_DIR=/var/data/uploads

# The owner configures the HTTPS funding link in Admin → Funding, not in a public file.
