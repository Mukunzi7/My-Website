# Learnwella production environment example.
# Copy these into your hosting provider's environment variables (e.g. Render → Environment).
# NEVER commit real secrets — this file is public.

HOST=0.0.0.0
PORT=10000
# Public HTTPS URL with NO trailing slash. Used in verification emails and sitemap.xml.
APP_BASE_URL=https://learnwella.onrender.com

# Bird / MessageBird email API — required for real signups (email verification).
# Replace bk_xxxxxxxxx with your real key only in your host's dashboard.
BIRD_API_KEY=bk_xxxxxxxxx
BIRD_FROM=onboarding@messagebird.dev
# Optional. Usually auto-detected from key prefix: bk_us1_... or bk_eu1_...
BIRD_REGION=us1

# Owner admin account created automatically the FIRST time the app starts.
# Use a long, unique password. Changing this later does not reset an existing account.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=CHANGE-ME-TO-A-LONG-UNIQUE-PASSWORD

# Alternative to Bird: SMTP for verification and password reset emails.
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@yourdomain.com
SMTP_TLS=1

# Cloud uploads through a Cloudinary unsigned upload preset (optional).
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset

# Persistent storage (optional but strongly recommended on Render).
# Point both at a mounted Render Disk so data survives deploys.
# DB_PATH=/var/data/learnwella.sqlite3
# UPLOAD_DIR=/var/data/uploads

# Future PostgreSQL production database.
# Current app still uses SQLite unless a PostgreSQL adapter is added.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/learnwella

# Funding model: each project creator enters their own Mobile Money details.
# Sponsors send funds directly to the creator, not to the platform owner.
MOMO_PAYMENT_INSTRUCTIONS=Send via MTN MoMo and include the pledge reference.

# Optional project upload app limit in bytes. 0 means no Learnwella app limit.
# Profile photos are always capped at 10 MB.
MAX_UPLOAD_BYTES=0
